# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/clinic_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# JWT Security (Base64 encoded 256-bit+ secret)
JWT_SECRET=replace_with_a_strong_base64_secret_key_at_least_32_bytes
JWT_EXPIRATION=86400000

# Initial SuperAdmin (Created only when users table is empty)
APP_SUPERADMIN_EMAIL=superadmin@clinic.com
APP_SUPERADMIN_PASSWORD=ChangeMeStrongPassword123!

# Demo Data Seeding (Set true ONLY in local dev)
APP_SEED_ENABLED=false
SPRING_PROFILES_ACTIVE=prod